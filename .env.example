# Oh My Kitty commerce environment placeholders.
# Copy to .env.local for local work. Never commit real credentials.

# Firebase web app config.
# These are client-side Firebase config values. Keep real values out of this example.
NEXT_PUBLIC_FIREBASE_API_KEY="replace-later"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="replace-later.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="replace-later"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="replace-later.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace-later"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-later"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="replace-later"

# App/runtime environment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Oh My Kitty"
APP_ENV="development"

# Firebase Admin / server-side credentials.
# Prefer Google Application Default Credentials in deployed Firebase environments.
# For local non-emulator work, point this to a local service-account JSON file that is not committed.
GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/local-service-account.json"

# Payment provider placeholders. Final provider is TBD.
PAYMENT_PROVIDER="tbd"
PAYMENT_PUBLIC_KEY="replace-later"
PAYMENT_SECRET_KEY="replace-later"
PAYMENT_WEBHOOK_SECRET="replace-later"

# Notifications placeholders.
EMAIL_FROM="replace-later"
EMAIL_PROVIDER_API_KEY="replace-later"
SMS_PROVIDER_API_KEY="replace-later"
WHATSAPP_PROVIDER_TOKEN="replace-later"

# Analytics/monitoring placeholders.
NEXT_PUBLIC_ANALYTICS_ID="replace-later"
SENTRY_DSN="replace-later"
