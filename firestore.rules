rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.isAdmin == true;
    }

    function isStaff() {
      return signedIn() && (request.auth.token.isStaff == true || request.auth.token.isAdmin == true);
    }

    function activeProduct() {
      return resource.data.status == "ACTIVE";
    }

    match /products/{productId} {
      allow read: if activeProduct() || isStaff();
      allow create, update, delete: if false;

      match /variants/{variantId} {
        allow read: if isStaff() || get(/databases/$(database)/documents/products/$(productId)).data.status == "ACTIVE";
        allow create, update, delete: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if false;
    }

    match /collections/{collectionId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if false;
    }

    match /contentPages/{pageId} {
      allow read: if resource.data.status == "PUBLISHED" || isStaff();
      allow create, update, delete: if false;
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == "public" || isStaff();
      allow create, update, delete: if false;
    }

    match /media/{mediaId} {
      allow read: if resource.data.visibility == "PUBLIC" || isStaff();
      allow create, update, delete: if false;
    }

    match /promotions/{promotionId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if false;
    }

    match /deliveryRules/{deliveryRuleId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    match /roles/{roleId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /inventoryMovements/{movementId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /approvalRequests/{approvalId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /posShifts/{shiftId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
